# ---------------------------------------------------------------
# FREE external database (не на нашому сервері, безкоштовно)
# ---------------------------------------------------------------
# Варіант A — Neon (neon.tech): створіть проєкт і скопіюйте Connection string
DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Варіант B — Supabase (supabase.com): Settings -> Database -> Connection string
# DATABASE_URL=postgresql://postgres.xxx:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Варіант C — Vercel Postgres: просто підключіть інтеграцію, змінна підхопиться сама
# POSTGRES_URL=

# ---------------------------------------------------------------
# Admin (вхід в /adminpanel)
# ---------------------------------------------------------------
ADMIN_EMAIL=admin@bus-rent.ua
ADMIN_PASSWORD=busrent2026
JWT_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------
# Telegram-бот: сповіщення про заявки + команди (/id, /leads, /stats)
# ---------------------------------------------------------------
# Токен від @BotFather. Можна задати тут АБО в адмінці: Telegram-бот → Токен.
TELEGRAM_BOT_TOKEN=
# Необов'язково: додатковий чат для заявок (напр. група), якщо не використовуєте список адмінів
TELEGRAM_CHAT_ID=
# Публічна адреса сайту (для webhook). На Vercel підставляється автоматично.
# NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
